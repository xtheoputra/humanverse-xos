# Salin ke `.env` (diabaikan git). Semua nilai di bawah KHUSUS lokal.
# docker compose membaca berkas ini otomatis.

# Port hos — ganti kalau sudah dipakai proyek lain di mesin yang sama.
HVX_API_PORT=8000
HVX_POSTGRES_PORT=5432
HVX_REDIS_PORT=6379

# PostgreSQL lokal — peran PEMILIK skema. Dipakai migrasi, TIDAK PERNAH oleh api.
HVX_POSTGRES_USER=hvx
HVX_POSTGRES_PASSWORD=ganti-dengan-kata-sandi-lokal
HVX_POSTGRES_DB=hvx

# Peran LOGIN api — anggota `hvx_app`, bukan superuser, bukan pemilik tabel
# (B-40). Dibuat layanan compose `db-roles`; api menolak mulai dengan peran lain.
HVX_API_DB_USER=hvx_api
HVX_API_DB_PASSWORD=ganti-dengan-kata-sandi-api-lokal

HVX_LOG_LEVEL=INFO

# Kunci HMAC untuk sidik IP di audit & batas laju — WAJIB, minimal 32 karakter.
# IP mentah tidak pernah disimpan; sha256 polos atas IPv4 bisa dibalik.
HVX_IP_HASH_KEY=ganti-dengan-kunci-acak-minimal-32-karakter

# Wajib bagi api — tanpa nilai bawaan (lingkungan yang lupa diisi GAGAL mulai).
HVX_ENV=local

# Uji integrasi (pytest) memakai layanan compose di atas. ⚠️ pytest dan `uv run`
# TIDAK membaca berkas ini — ekspor kedua variabel ini di shell. Tanpa keduanya
# uji integrasi GAGAL — sengaja, bukan dilewati. DSN uji adalah peran PEMILIK:
# uji membuat basis data sekali pakai dan peran login `hvx_api_uji` sendiri, lalu
# menyambungkan api sebagai peran itu — bukan sebagai pemilik.
HVX_TEST_DATABASE_URL=postgresql://hvx:ganti-dengan-kata-sandi-lokal@127.0.0.1:5432/hvx
HVX_TEST_REDIS_URL=redis://127.0.0.1:6379/0
