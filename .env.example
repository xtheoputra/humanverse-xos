# Salin ke `.env` (diabaikan git). Semua nilai di bawah KHUSUS lokal.
# docker compose membaca berkas ini otomatis.

# Port hos — ganti kalau sudah dipakai proyek lain di mesin yang sama.
HVX_API_PORT=8000
HVX_POSTGRES_PORT=5432
HVX_REDIS_PORT=6379
HVX_QDRANT_PORT=6333

# PostgreSQL lokal — peran PEMILIK skema. Dipakai migrasi, TIDAK PERNAH oleh api.
HVX_POSTGRES_USER=hvx
HVX_POSTGRES_PASSWORD=ganti-dengan-kata-sandi-lokal
HVX_POSTGRES_DB=hvx

# Peran LOGIN api — anggota `hvx_app`, bukan superuser, bukan pemilik tabel
# (B-40). Dibuat layanan compose `db-roles`; api menolak mulai dengan peran lain.
HVX_API_DB_USER=hvx_api
HVX_API_DB_PASSWORD=ganti-dengan-kata-sandi-api-lokal

# Peran LOGIN proses pekerja — anggota `hvx_app` DAN `hvx_pekerja`: satu-satunya yang
# boleh memanggil fungsi relay & penyelaras (linimasa semua pengguna di luar RLS).
# WAJIB berbeda dari peran api — api menolak mulai sebagai anggota `hvx_pekerja` (S4).
HVX_PEKERJA_DB_USER=hvx_pekerja_login
HVX_PEKERJA_DB_PASSWORD=ganti-dengan-kata-sandi-pekerja-lokal

HVX_LOG_LEVEL=INFO

# Kunci HMAC untuk sidik IP di audit & batas laju — WAJIB, minimal 32 karakter.
# IP mentah tidak pernah disimpan; sha256 polos atas IPv4 bisa dibalik.
HVX_IP_HASH_KEY=ganti-dengan-kunci-acak-minimal-32-karakter

# Wajib bagi api — tanpa nilai bawaan (lingkungan yang lupa diisi GAGAL mulai).
HVX_ENV=local

# Kunci penyemat memori (K-26) — minimal 32 karakter, WAJIB bila HVX_QDRANT_URL diisi
# (compose mengisinya untuk pekerja). Tanpa kunci, vektor di Qdrant bisa dibalik
# menjadi kata-kata isi jurnal. Menggantinya = seluruh memori disemat ulang.
HVX_SEMATAN_KEY=ganti-dengan-kunci-acak-minimal-32-karakter

# AI Gateway (K-28): model per kelas, `penyedia/nama`. V0 hanya penyedia `lokal` —
# tanpa jaringan dan tanpa biaya; penyedia berbayar keputusan pemilik (A-6/#18).
# Harga USD per sejuta token [masuk, keluar]; model non-lokal tanpa harga ditolak.
# HVX_MODEL_SIMPLE=lokal/hvx-ringkas-v1
# HVX_MODEL_REASONING=lokal/hvx-nalar-v1
# HVX_MODEL_HARGA={}
# Anggaran biaya model per pengguna per 24 jam bergulir (K-32) — melewatinya menurunkan
# kelas model ke `simple`, tidak menolak. Angka sebenarnya milik pemilik (uang).
# HVX_AI_ANGGARAN_HARIAN_USD=0.50

# Asal peramban yang boleh memanggil api, dipisah koma — aplikasi Flutter web lokal:
#   flutter run -d chrome --web-port 5000 --dart-define=HVX_API=http://127.0.0.1:8000
# Kosong = tanpa CORS. `*` ditolak.
HVX_CORS_ORIGINS=http://localhost:5000

# Uji integrasi (pytest) memakai layanan compose di atas. ⚠️ pytest dan `uv run`
# TIDAK membaca berkas ini — ekspor kedua variabel ini di shell. Tanpa keduanya
# uji integrasi GAGAL — sengaja, bukan dilewati. DSN uji adalah peran PEMILIK:
# uji membuat basis data sekali pakai dan peran login `hvx_api_uji` sendiri, lalu
# menyambungkan api sebagai peran itu — bukan sebagai pemilik.
HVX_TEST_DATABASE_URL=postgresql://hvx:ganti-dengan-kata-sandi-lokal@127.0.0.1:5432/hvx
HVX_TEST_REDIS_URL=redis://127.0.0.1:6379/0
# Memori vektor (spec/07 3.5): uji membuat koleksi sekali pakai `uji-*` dan menghapusnya.
HVX_TEST_QDRANT_URL=http://127.0.0.1:6333
