# Salin ke `.env` (diabaikan git). Semua nilai di bawah KHUSUS lokal.
# docker compose membaca berkas ini otomatis.

# Port hos — ganti kalau sudah dipakai proyek lain di mesin yang sama.
HVX_API_PORT=8000
HVX_POSTGRES_PORT=5432
HVX_REDIS_PORT=6379

# Kredensial PostgreSQL lokal
HVX_POSTGRES_USER=hvx
HVX_POSTGRES_PASSWORD=ganti-dengan-kata-sandi-lokal
HVX_POSTGRES_DB=hvx

HVX_LOG_LEVEL=INFO

# Wajib bagi api — tanpa nilai bawaan (lingkungan yang lupa diisi GAGAL mulai).
HVX_ENV=local

# Uji integrasi (pytest) memakai layanan compose di atas. ⚠️ pytest dan `uv run`
# TIDAK membaca berkas ini — ekspor kedua variabel ini di shell. Tanpa keduanya
# uji integrasi GAGAL — sengaja, bukan dilewati.
HVX_TEST_DATABASE_URL=postgresql://hvx:ganti-dengan-kata-sandi-lokal@127.0.0.1:5432/hvx
HVX_TEST_REDIS_URL=redis://127.0.0.1:6379/0
